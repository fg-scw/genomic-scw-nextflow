# Copy to backend.hcl and replace the bucket name before terraform init.
# Use the same pre-created, versioned state bucket as the infrastructure phase.
bucket                      = "REPLACE_WITH_PRECREATED_STATE_BUCKET"
key                         = "hcl-public-netflow/kubernetes.tfstate"
region                      = "fr-par"
endpoint                    = "https://s3.fr-par.scw.cloud"
skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
force_path_style            = true
encrypt                     = true
use_lockfile                = true
