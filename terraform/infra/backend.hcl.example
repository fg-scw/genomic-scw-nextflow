# Copy to backend.hcl and replace the bucket name before terraform init.
# The bucket must already exist and must be versioned (bootstrap is documented
# in the repository README). Credentials are read from AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY, never from this file or Terraform variables.
bucket                      = "REPLACE_WITH_PRECREATED_STATE_BUCKET"
key                         = "hcl-public-netflow/infra.tfstate"
region                      = "fr-par"
endpoints                   = { s3 = "https://s3.fr-par.scw.cloud" }
skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
use_path_style              = true
encrypt                     = true
use_lockfile                = true
