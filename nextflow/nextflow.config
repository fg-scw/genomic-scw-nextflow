/*
 * Reproducible Kapsule profile for nf-core/rnaseq 3.14.0.
 * STAR index generation is intentionally delegated to this pinned pipeline so
 * its STAR_GENOMEGENERATE and STAR_ALIGN containers use compatible versions.
 */

plugins {
  id 'nf-amazon@3.4.1'
  // Nextflow 25.10 auto-selects nf-k8s for executor=k8s; pin the last
  // compatible release for 25.10 rather than resolving a newer plugin.
  id 'nf-k8s@1.2.2'
}

profiles {
  scaleway_kapsule {
    workDir = '/data/workdir/work'

    // These run-ID based report paths remain stable during -resume.
    report.overwrite   = true
    timeline.overwrite = true
    trace.overwrite    = true

    k8s {
      namespace        = 'bioinformatics'
      serviceAccount   = 'nextflow'
      storageClaimName = 'nf-workdir-pvc'
      storageMountPath = '/data/workdir'
      imagePullPolicy  = 'IfNotPresent'
      pod = [
        [volumeClaim: 'nf-reference-pvc', mountPath: '/data/reference', readOnly: true],
        [env: 'AWS_ACCESS_KEY_ID', secret: 'pipeline-s3-credentials/access-key'],
        [env: 'AWS_SECRET_ACCESS_KEY', secret: 'pipeline-s3-credentials/secret-key'],
        [env: 'AWS_ENDPOINT_URL_S3', secret: 'pipeline-s3-credentials/s3-endpoint'],
        [env: 'AWS_DEFAULT_REGION', value: System.getenv('AWS_DEFAULT_REGION') ?: 'fr-par'],
      ]
    }

    process {
      executor = 'k8s'
      // Both PVCs must be attached to every task pod; the orchestrator pool
      // supports only one Scaleway File Storage volume per node.
      pod = [
        [nodeSelector: ['k8s.scaleway.com/pool-name': 'star-compute']],
        [toleration: [key: 'workload', value: 'star-compute', operator: 'Equal', effect: 'NoSchedule']],
      ]

      withName: '.*' {
        cpus   = 2
        memory = '8.GB'
        time   = '4.h'
      }

      withName: '.*STAR_ALIGN.*' {
        cpus    = 7
        memory  = '52.GB'
        time    = '8.h'
        // Default to shared SFS until node-local ephemeral capacity is verified.
        scratch = false
      }

      withName: '.*STAR_GENOMEGENERATE.*' {
        cpus   = 7
        memory = '56.GB'
        time   = '6.h'
      }

      withName: '.*HISAT2_ALIGN.*' {
        cpus   = 7
        memory = '52.GB'
        time   = '8.h'
      }

      withName: '.*SAMTOOLS_SORT.*' {
        cpus   = 7
        memory = '32.GB'
        time   = '4.h'
      }

      withName: '.*SALMON_INDEX.*' {
        cpus   = 4
        memory = '32.GB'
        time   = '2.h'
      }

      withName: '.*SALMON_QUANT.*' {
        cpus   = 2
        memory = '24.GB'
        time   = '2.h'
      }

      withName: '.*MULTIQC.*' {
        cpus   = 1
        memory = '4.GB'
        time   = '1.h'
      }
    }

    aws {
      client {
        endpoint          = System.getenv('AWS_ENDPOINT_URL_S3') ?: 'https://s3.fr-par.scw.cloud'
        s3PathStyleAccess = true
        maxConnections    = 20
        maxErrorRetry     = 5
      }
    }
  }

  // Opt-in benchmark only. The Nextflow driver stays on star-compute; task
  // pods use the temporary MEMORY3 pool and its attached local /scratch NVMe.
  // hostPath is outside kubelet ephemeral-storage accounting; keep STAR serial
  // and watch the 160 GB volume separately. Declared outputs stage back to SFS.
  gen3_scratch_benchmark {
    process {
      withName: '.*STAR_(ALIGN|GENOMEGENERATE).*' {
        pod = [
          [nodeSelector: ['k8s.scaleway.com/pool-name': 'gen3-probe']],
          [toleration: [key: 'workload', value: 'gen3-probe', operator: 'Equal', effect: 'NoSchedule']],
          [hostPath: '/scratch', mountPath: '/scratch'],
          [env: 'TMPDIR', value: '/scratch'],
        ]
        scratch = true
        // The runner preflight checks one node. Recheck inside every STAR pod
        // so a replacement node without the expected NVMe fails before STAR.
        beforeScript = '''
set -eu
mount_record="$(awk '$2 == "/scratch" { print $1, $3; exit }' /proc/mounts)"
root_source="$(awk '$2 == "/" { print $1; exit }' /proc/mounts)"
mount_source="${mount_record%% *}"
mount_type="${mount_record#* }"
[ "$mount_type" = ext4 ] || { echo "Expected ext4 at /scratch; found ${mount_type:-no mount}" >&2; exit 1; }
case "$mount_source" in /dev/*) ;; *) echo "Expected block device at /scratch; found ${mount_source:-no source}" >&2; exit 1 ;; esac
[ -n "$root_source" ] || { echo 'Could not determine root filesystem source' >&2; exit 1; }
[ "$mount_source" != "$root_source" ] || { echo '/scratch shares its filesystem source with root' >&2; exit 1; }
[ -w /scratch ] || { echo '/scratch is not writable' >&2; exit 1; }
available_kib="$(df -Pk /scratch | awk 'NR == 2 { print $4 }')"
echo "$available_kib" | grep -Eq '^[0-9]+$' || { echo 'Could not determine available /scratch capacity' >&2; exit 1; }
[ "$available_kib" -ge 62914560 ] || { echo "Expected at least 60 GiB free on /scratch; found ${available_kib} KiB" >&2; exit 1; }
printf 'Verified scratch mount: source=%s filesystem=%s root-source=%s available=%sKiB' "$mount_source" "$mount_type" "$root_source" "$available_kib"
echo
'''
      }

      withName: '.*STAR_ALIGN.*' {
        maxForks = 1
      }

      withName: '.*STAR_GENOMEGENERATE.*' {
        stageInMode = 'copy'
      }
    }
  }
}
